{
  "version": 2,
  "framework": "nextjs",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Server",
          "value": "Apache/2.4.41 (Ubuntu) OpenSSL/1.1.1f"
        },
        {
          "key": "X-Powered-By",
          "value": "PHP/7.4.3"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Credentials",
          "value": "true"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PUT, DELETE, OPTIONS, TRACE"
        }
      ]
    }
  ]
}
